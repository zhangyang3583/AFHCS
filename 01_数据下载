Exomiser 数据要单独下(注释包里不含 Exomiser):

cd ~/annotsv_data

# Exomiser phenotype 数据
wget https://data.monarchinitiative.org/exomiser/data/2406_phenotype.zip
unzip 2406_phenotype.zip

# Exomiser hg19/hg38 数据(你用 GRCh38)
wget https://data.monarchinitiative.org/exomiser/data/2406_hg38.zip
unzip 2406_hg38.zip

# 这些目录要按 AnnotSV 期望的结构放好
# 期望路径:Annotations_Exomiser/2406/...
mkdir -p Annotations_Exomiser/2406
mv 2406_phenotype Annotations_Exomiser/2406/
mv 2406_hg38 Annotations_Exomiser/2406/
